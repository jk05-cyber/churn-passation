import sys
sys.path.insert(1, '/mnt')
import pandas as pd
import numpy as np
dom = pd.read_csv('domicilie_salaire_operations_september_2024.csv', sep =',') 
dom

v=pd.read_excel('fonctionnaire_CC_VF.xlsx')
v
#VT=v[v['Stats_StatusText']=='VENTE']
VT=v
def normaliser(ID_SAB):
    if len(ID_SAB)==5:
        return '100'+ ID_SAB
    elif len(ID_SAB)==6:
        return '10'+ ID_SAB
    elif len(ID_SAB)==7:
        return '1'+ ID_SAB
    else:
        return ID_SAB
VT=VT.rename(columns={"Identifiant Client":"ID_SAB"})
VT
VT['ID_SAB']=VT['ID_SAB'].astype(str)
VT['ID_SAB']=VT['ID_SAB'].apply(normaliser)
VT
dom=dom.rename(columns={"Identifiant_SAB":"ID_SAB"})
dom
dom['ID_SAB']=dom['ID_SAB'].astype(str)
VF=VT.merge(dom,on='ID_SAB',how='left')
VF
VF.to_csv('domicilier_FONCTIONNAIRE.csv')
